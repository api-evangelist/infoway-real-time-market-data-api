            "url": "https://data.infoway.io/common/batch_depth/:codes",
            "params": [
              {
                "name": "codes",
                "value": "",
                "type": "path",
                "description": "标的列表，多个用,间隔，最大支持100个标的"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "apiKey",
              "value": "{{apiKey}}",
              "placement": "header"
            }
          }
        },
